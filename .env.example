# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
# Required to call POST /api/admin/* (sync-history, migrate) on a public
# deployment -- those endpoints run alembic migrations and trigger
# multi-year external data backfills. Generate with e.g. `openssl rand -hex 32`
# and pass it back as the X-Admin-Key header. Leaving this unset makes every
# /api/admin/* request return 401.
ADMIN_API_KEY=

# ---- Infrastructure ----
DATABASE_URL=postgresql+asyncpg://market_intel:market_intel@localhost:5432/market_intel
REDIS_URL=redis://localhost:6379/0

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs that automatic reports are broadcast to, e.g. "123456789,-100987654321"
TELEGRAM_BROADCAST_CHAT_IDS=

# ---- LLM (Google Gemini, optional but recommended) ----
# Preferred provider when set -- Gemini has a genuine ongoing free tier
# (unlike Anthropic/OpenAI/xAI below, which are pay-per-token with only a
# one-time trial credit), so this is the cheapest way to run report
# generation continuously. Falls back to Anthropic, then OpenAI, then xAI,
# if unset or its call fails. Free key: https://aistudio.google.com/apikey
# GEMINI_MODEL defaults to the "-latest" alias rather than a pinned version
# -- pinned Gemini model names get deprecated for new API keys/projects
# without warning (observed live: gemini-2.5-flash returned 404 "no longer
# available to new users" while still listed by the models endpoint).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- LLM (Anthropic Claude, optional) ----
# Second choice, tried when Gemini is unconfigured or fails, falling back
# to OPENAI_API_KEY below on its own failure. Get a key at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---- LLM (OpenAI-compatible) ----
# Third choice, tried when Gemini/Anthropic are both unconfigured or fail,
# falling back to XAI_API_KEY below on its own failure.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- LLM (xAI Grok, optional) ----
# Last-resort fallback, or the only provider if Gemini/Anthropic/OpenAI are
# all unconfigured. xAI's API is OpenAI-compatible, reusing the same
# transport with a different base URL/model. At least one of GEMINI_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY or XAI_API_KEY is required for AI
# analysis / report generation. Key at https://console.x.ai/.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# ---- Crypto data (CoinGecko) ----
# Optional for live snapshots; a free CoinGecko "Demo" API key raises your
# rate limit. For sync_history.py's historical backfill, CoinGecko's
# /market_chart endpoint may require this key even on the free tier
# (observed HTTP 401/429 without one during development) -- see README.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ---- Macro data (FRED - Federal Reserve Economic Data) ----
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Required for Fed Funds Rate, VIX, US10Y, US30Y and WTI Oil.
FRED_API_KEY=

# ---- Indices/stocks fallback chain ----
# Primary: Twelve Data (free tier: 800 requests/day). Covers indices
# (NASDAQ/SPX/DJI/RUT), the Magnificent 7, and macro (DXY/Gold/Silver).
# Free key: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
# Fallback: Alpha Vantage (free tier: 5 requests/min, 25/day total, shared
# with news sentiment below). Only ever used for the Magnificent 7 -- it has
# no honest substitute for index-level quotes. Also powers the news
# sentiment fallback. Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Both are optional: unset just skips that link of the chain (next is the
# existing yfinance path, then honestly "not available"). See
# app/services/market/multisource_stocks.py and multisource_macro.py.

# ---- Whale/on-chain derivatives data ----
# Primary: CoinGlass (free tier). Fallback: CoinGecko's keyless
# `/derivatives` endpoint (no key needed -- reuses COINGECKO_API_KEY above
# if set, works unauthenticated otherwise). Both cover derivatives-market
# aggregates only (funding rate, open interest -- CoinGlass adds
# liquidations and long/short ratio) -- neither is an on-chain wallet
# tracker, so exchange netflow / large-wallet-change / stablecoin-supply-
# change stay honestly unavailable even with these configured. See
# app/services/whales/engine.py.
# Free key: https://www.coinglass.com/pricing
COINGLASS_API_KEY=

# ---- On-chain intelligence (v4.0) ----
# No provider is wired in yet -- OnChainIntelligenceEngine honestly reports
# exchange netflow/reserves, SOPR, MVRV, NUPL, dormancy, coin days
# destroyed, active/new addresses, TVL, stablecoin supply and large
# transfers as unavailable regardless of these being set, until a client
# for one of these is implemented. Glassnode covers general on-chain
# metrics; Helius is a Solana-native indexer for Solana-specific whale
# wallet activity / DEX volume / bridge activity. See
# app/services/onchain/engine.py.
GLASSNODE_API_KEY=
HELIUS_API_KEY=

# ---- TradingView MCP: Institutional Technical Analysis Provider (v5.3) ----
# No MCP server is configured by default -- TechnicalAnalysisProvider falls
# back to indicators computed locally from this project's own synced OHLCV
# history (1h/4h/1d only). Set both to point at a real TradingView MCP
# endpoint to prefer it. See app/services/technical/provider.py.
TRADINGVIEW_MCP_URL=
TRADINGVIEW_MCP_API_KEY=

# ---- Sentiment (V2) ----
# No key needed: the Crypto Fear & Greed Index (api.alternative.me) is free
# and unauthenticated. News sentiment falls back to ALPHAVANTAGE_API_KEY
# above when the RSS News Engine has nothing for the window. Twitter/X,
# Reddit and options-market sentiment have no configured source -- see
# app/services/sentiment/engine.py.

# ---- Scheduling ----
MARKET_DATA_INTERVAL_MINUTES=5
NEWS_COLLECTION_INTERVAL_MINUTES=10
ANALYSIS_INTERVAL_MINUTES=30
REPORT_INTERVAL_MINUTES=30
# v5.5 Market Scanner: how often the ~500-symbol universe is re-scanned, and
# how often the universe list itself (top 500 by market cap) is refreshed.
SCANNER_INTERVAL_MINUTES=15
SCANNER_UNIVERSE_REFRESH_HOURS=24
HTTP_TIMEOUT_SECONDS=15

# ---- Forecast / Prediction Quality (V9) ----
# Width (percentage points) of each Prediction Quality Lab calibration
# bucket -- how finely "stated confidence vs. observed accuracy" is binned.
CALIBRATION_BIN_WIDTH_PCT=10
