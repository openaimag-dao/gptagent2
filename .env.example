# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Infrastructure ----
DATABASE_URL=postgresql+asyncpg://market_intel:market_intel@localhost:5432/market_intel
REDIS_URL=redis://localhost:6379/0

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=

# ---- LLM (OpenAI-compatible) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Crypto data (CoinGecko) ----
# Optional: a free CoinGecko "Demo" API key raises your rate limit.
# Leave blank to use the public, unauthenticated endpoint.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ---- Macro data (FRED - Federal Reserve Economic Data) ----
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Required only for the Fed Funds Rate indicator; all other macro
# indicators (DXY, Gold, Silver, Oil, US10Y, US30Y, VIX) need no key.
FRED_API_KEY=

# ---- Scheduling ----
MARKET_DATA_INTERVAL_MINUTES=5
HTTP_TIMEOUT_SECONDS=15
